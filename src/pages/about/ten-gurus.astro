---
import PageLayout from "@/layouts/Base.astro";
import AboutSubnav from "@/components/about/AboutSubnav.astro";
import AboutPageHero from "@/components/about/AboutPageHero.astro";
import { guruPortraitByNumber } from "@/data/about/images";
import content from "@/data/about/gurus.json";

const meta = {
	description:
		"The ten Sikh Gurus and Sri Guru Granth Sahib Ji — lives, contributions, and eternal Guruship — GSS of North Texas.",
	title: "The 10 Sikh Gurus — GSS of North Texas",
};
---

<PageLayout meta={meta}>
	<AboutSubnav />
	<AboutPageHero
		eyebrow={content.hero.eyebrow}
		title={content.hero.title}
		subtitle={content.hero.subtitle}
	/>

	<div class="flex flex-col gap-16 md:gap-20">
		{
			content.gurus.map((guru, i) => {
				const src = guruPortraitByNumber[guru.number as number];
				const left = i % 2 === 0;
				return (
					<article id={`guru-${guru.number}`} class="scroll-mt-28">
						<div
							class:list={[
								"grid items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16",
								left ? "" : "md:[&>div:first-child]:order-2",
							]}
						>
							<div class="relative flex flex-col items-center">
								{src && (
									<img
										src={src}
										alt={guru.name}
										class="max-h-[min(420px,70vh)] w-auto max-w-full rounded-xl object-contain shadow-lg"
										loading="lazy"
									/>
								)}
								<span class="mt-4 flex h-10 w-10 items-center justify-center rounded-full bg-accent-base/20 text-lg font-bold text-accent-one">
									{guru.number}
								</span>
							</div>
							<div>
								<p lang="pa" class="text-xl text-accent-one md:text-2xl">{guru.gurmukhi}</p>
								<h2 class="mt-1 text-2xl font-bold text-accent-two md:text-3xl">{guru.name}</h2>
								<p class="mt-2 text-sm text-textColor/85 md:text-base">
									{guru.birth} – {guru.jotiJot} · {guru.birthplace}
								</p>
								<div class="mt-6">
									<p class="text-sm font-semibold uppercase tracking-wide text-accent-one">
										Key contributions
									</p>
									<ul class="mt-3 list-inside list-disc space-y-2">
										{guru.contributions.map((line) => (
											<li class="leading-relaxed">{line}</li>
										))}
									</ul>
								</div>
								<blockquote class="mt-8 border-l-4 border-accent-one/70 pl-4">
									<p class="italic leading-relaxed">“{guru.quote}”</p>
									<footer class="mt-2 text-sm text-textColor/80">— {guru.quoteSource}</footer>
								</blockquote>
							</div>
						</div>
					</article>
				);
			})
		}
	</div>

	<section class="mt-20 rounded-2xl border border-special-lighter bg-special-light/40 p-8 md:p-12">
		<p lang="pa" class="text-center text-xl text-accent-one">{content.granth.gurmukhi}</p>
		<h2 class="mt-2 text-center text-2xl font-bold text-accent-two md:text-3xl">
			{content.granth.title}
		</h2>
		<p class="mt-2 text-center font-medium text-accent-two/90">{content.granth.subtitle}</p>
		<p class="mx-auto mt-6 max-w-3xl text-center leading-relaxed">{content.granth.description}</p>
		<div class="mx-auto mt-10 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				content.granth.facts.map((f) => (
					<div class="rounded-lg border border-accent-one/15 bg-bgColor/70 p-4 text-center">
						<p class="text-lg font-bold text-accent-one">{f.value}</p>
						<p class="text-sm text-textColor/80">{f.label}</p>
					</div>
				))
			}
		</div>
	</section>
</PageLayout>
